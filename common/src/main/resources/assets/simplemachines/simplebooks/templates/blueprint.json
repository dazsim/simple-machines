{
  "extends": "simplebooks:text",
  "vars": {
    "rule": "#9cc0e4"
  },
  "styles": {
    "title": {
      "color": "$head",
      "scale": 2,
      "align": "center"
    },
    "body": {
      "color": "$ink",
      "line_height": 20
    }
  },
  "slots": {
    "left.body": {
      "box": [
        0,
        100,
        644,
        330
      ]
    },
    "left.drawing": {
      "type": "image_box",
      "box": [
        42,
        440,
        560,
        350
      ],
      "bind": "drawing",
      "frame": false,
      "optional": true
    },
    "left.caption": {
      "type": "subtitle",
      "box": [
        0,
        800,
        644,
        18
      ],
      "bind": "caption",
      "style": "subtitle",
      "optional": true
    }
  }
}
