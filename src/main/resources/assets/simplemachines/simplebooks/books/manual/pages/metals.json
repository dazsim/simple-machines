{
  "section": "start",
  "sort": 1,
  "title": "Metals",
  "subtitle": "Steel, redstone copper, rods and plates",
  "text": "The Alloy Furnace mixes two inputs. The Extruder turns an iron or copper ingot into 2 rods. Once you have power, the Rolling Mill rolls ingots into rods, or plates into casings; the button in its screen switches between them.\n\nPlates come from the Compressor, one ingot each. Steel rods only come from the Rolling Mill. The Tool Stand and Diamond Drill Bit need them.\n\nCopper, steel and gold follow the iron cards. Plates are tagged c:plates.",
  "drawing": "simplemachines:textures/simplebooks/manual/metals.png",
  "caption": "Alloy Furnace, side view",
  "right_title": "Recipes",
  "steps": [
    {
      "kind": "process",
      "inputs": [
        "#simplemachines:ingots_or_dusts/iron",
        {
          "item": "#minecraft:coals",
          "count": 2
        }
      ],
      "appliance": "simplemachines:alloy_furnace",
      "output": "simplemachines:steel_ingot"
    },
    {
      "kind": "process",
      "inputs": [
        "#simplemachines:ingots_or_dusts/copper",
        "#c:dusts/redstone"
      ],
      "appliance": "simplemachines:alloy_furnace",
      "output": "simplemachines:redstone_copper_ingot"
    },
    {
      "kind": "process",
      "inputs": [
        "#c:ingots/iron"
      ],
      "appliance": "simplemachines:extruder",
      "output": {
        "item": "simplemachines:iron_rod",
        "count": 2
      }
    },
    {
      "kind": "process",
      "inputs": [
        "#c:ingots/iron"
      ],
      "appliance": "simplemachines:compressor",
      "output": "simplemachines:iron_sheet"
    },
    {
      "kind": "process",
      "inputs": [
        "#c:ingots/steel"
      ],
      "appliance": "simplemachines:rolling_mill",
      "output": {
        "item": "simplemachines:steel_rod",
        "count": 2
      },
      "note": "Rod mode"
    }
  ]
}
